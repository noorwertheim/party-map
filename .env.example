# Default: saved Party Atlas response; never calls the events API.
VITE_EVENT_PROVIDER=fixture

# Local development only: change to partyAtlas in .env.local to enable requests.
# The production build always uses fixtures for this undocumented provider.
VITE_PARTY_ATLAS_URL=https://partyatlas.app/api/ra-events
VITE_PARTY_ATLAS_AREA_ID=29
VITE_PARTY_ATLAS_CITY=Amsterdam
VITE_PARTY_ATLAS_TIME_ZONE=Europe/Amsterdam
# These area settings select the initial source area; location search resolves other areas automatically.
# Optional separate area lookup route (defaults to resolve-area beside the events URL):
# VITE_PARTY_ATLAS_RESOLVE_URL=https://partyatlas.app/api/resolve-area

# Optional: a different Photon-compatible geocoder endpoint.
# VITE_GEOCODING_URL=https://photon.komoot.io/api/
